# Staging Environment Configuration
ENVIRONMENT=staging
APP_NAME=Hospital Management Staging
APP_DISPLAY_NAME=HospitalMgmt Stage
APP_BUNDLE_ID=com.octusai.hospital.staging

# API Configuration
API_BASE_URL=https://staging-api.octusai.com/api
AUTH_API_BASE_URL=https://staging-api.octusai.com/api
API_TIMEOUT=30000

# Firebase Configuration - Staging Project
FIREBASE_PROJECT_ID=user-management-fd816
FIREBASE_STORAGE_BUCKET=user-management-fd816.firebasestorage.app
FIREBASE_WEB_CLIENT_ID=YOUR_STAGING_WEB_CLIENT_ID

# Features & Debug
ENABLE_FLIPPER=false
ENABLE_DEBUG_LOGGING=true
ENABLE_DEV_MENU=false
ENABLE_PERFORMANCE_MONITORING=true

# Notification Configuration
FCM_DEFAULT_CHANNEL_ID=staging_notifications
NOTIFICATION_SOUND=notification_staging.mp3

# App Configuration
API_VERSION=v1
APP_VERSION_CODE=2
SENTRY_ENABLED=true
ANALYTICS_ENABLED=true
