# Production Environment Configuration
ENVIRONMENT=production
APP_NAME=Hospital Management
APP_DISPLAY_NAME=Hospital Management
APP_BUNDLE_ID=com.octusai.hospital

# API Configuration
API_BASE_URL=https://app.octusai.com/api
AUTH_API_BASE_URL=https://app.octusai.com/api
API_TIMEOUT=30000

# Firebase Configuration - Production Project
FIREBASE_PROJECT_ID=user-management-fd816
FIREBASE_STORAGE_BUCKET=user-management-fd816.firebasestorage.app
FIREBASE_WEB_CLIENT_ID=YOUR_PROD_WEB_CLIENT_ID

# Features & Debug
ENABLE_FLIPPER=false
ENABLE_DEBUG_LOGGING=false
ENABLE_DEV_MENU=false
ENABLE_PERFORMANCE_MONITORING=true

# Notification Configuration
FCM_DEFAULT_CHANNEL_ID=default_notification_channel
NOTIFICATION_SOUND=notification_sound.mp3

# App Configuration
API_VERSION=v1
APP_VERSION_CODE=100
SENTRY_ENABLED=true
ANALYTICS_ENABLED=true
