{
  "name": "HospitalManagement",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android:dev": "ENVFILE=.env.development react-native run-android --mode=developmentDebug",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode=productionRelease",
    "ios:dev": "ENVFILE=.env.development react-native run-ios --scheme HospitalManagementDev",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme HospitalManagementStaging",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --scheme HospitalManagement",
    "build:android:dev": "cd android && ./gradlew assembleDebug",
    "build:android:staging": "cd android && ./gradlew assembleDebug",
    "build:android:prod": "cd android && ./gradlew assembleRelease",
    "env:dev": "cp .env.development .env && echo 'Switched to DEVELOPMENT environment'",
    "env:staging": "cp .env.staging .env && echo 'Switched to STAGING environment'",
    "env:prod": "cp .env.production .env && echo 'Switched to PRODUCTION environment'",
    "env:check": "echo 'Current environment:' && grep ENVIRONMENT= .env || echo 'No .env file found'",
    "env:debug": "node debug-environment.js",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "ios:clean": "cd ios && rm -rf build && rm -rf ~/Library/Developer/Xcode/DerivedData/UserManagementApp-* && cd ..",
    "cache:clear": "npx react-native start --reset-cache",
    "full:rebuild:android": "npm run cache:clear & npm run android:clean && npm run android",
    "full:rebuild:ios": "npm run cache:clear & npm run ios:clean && npm run ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-documents/picker": "^10.1.5",
    "@react-native-firebase/app": "^23.1.2",
    "@react-native-firebase/messaging": "^23.1.2",
    "@react-native-picker/picker": "^2.11.1",
    "@react-native/new-app-screen": "0.81.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "base-64": "^1.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-config": "^1.5.6",
    "react-native-date-picker": "^5.0.13",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-notification-sounds": "^0.5.8",
    "react-native-paper": "^5.14.5",
    "react-native-permissions": "^5.4.2",
    "react-native-picker-select": "^9.3.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.14.1",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@react-native/typescript-config": "0.81.0",
    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
